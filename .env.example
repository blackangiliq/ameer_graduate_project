# Copy to .env and adjust. All values are optional.
PORT=3000
NODE_ENV=development
# If empty, random secrets are generated once in data/secrets.json
JWT_SECRET=
MFA_ENCRYPTION_KEY=          # 64 hex chars (32 bytes)
ACCESS_TOKEN_TTL=900         # seconds (15 min)
REFRESH_TOKEN_TTL=604800     # seconds (7 days)
BCRYPT_COST=12
AUTH_RATE_LIMIT=30           # login/register/mfa requests per IP per 15 min
