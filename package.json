  "description": "Graduation project: Identity and Access Management (IAM) and Authentication system built with Node.js, SQLite and vanilla JavaScript",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
